DEBUG=false

# 数据库（Supabase Postgres）
# 注意：密码中的特殊字符需要 URL 编码
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

# 认证
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_EXPIRE_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=vidgrab_access_token

# 前后端地址
APP_BASE_URL=https://api.your-domain.com
FRONTEND_BASE_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=["https://your-frontend-domain.com"]
API_DOMAIN=api.your-domain.com
LETSENCRYPT_EMAIL=admin@your-domain.com

# 邮件
MAIL_MODE=resend
RESEND_API_KEY=replace-with-your-resend-key
MAIL_FROM_NAME=VidGrab
MAIL_FROM_ADDRESS=noreply@your-domain.com

# 支付（线上暂不开放）
PAYMENT_PROVIDER_MODE=disabled
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# 前端构建变量
VITE_PAYMENT_OPEN=false

# AI（可选）
AI_PROVIDER=openai_compatible
AI_MODEL=gpt-4o-mini
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-your-ai-key
AI_TIMEOUT_SECONDS=60
