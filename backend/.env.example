# ============================================================
# VidGrab 后端环境变量配置示例
# 复制此文件为 .env 并填入真实值
# ============================================================

# ------------------------------------------------------------
# 数据库配置
# 开发可继续使用 SQLite；生产建议使用 Supabase Postgres
# 若密码包含 @ : / # 等字符，需要进行 URL 编码
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./app.db
# Supabase 示例（SQLAlchemy）：
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

# ------------------------------------------------------------
# AI 配置
# 支持任意 OpenAI 兼容接口（DeepSeek / OpenAI / 本地模型等）
# ------------------------------------------------------------
AI_API_KEY=your-ai-api-key
AI_MODEL=deepseek-chat
AI_API_BASE_URL=https://api.deepseek.com
# OpenAI 示例：
# AI_MODEL=gpt-4o-mini
# AI_API_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------
# 邮件配置
# MAIL_MODE 可选值：local（开发调试）| resend（推荐生产）| smtp
# ------------------------------------------------------------
MAIL_MODE=local

# Resend 配置（MAIL_MODE=resend 时必填）
# 注册地址：https://resend.com
# 需在 Resend 控制台完成自定义域名 DNS 验证后才可发信
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM_NAME=VidGrab
MAIL_FROM_ADDRESS=noreply@mail.your-domain.com

# SMTP 配置（MAIL_MODE=smtp 时必填，适用于 QQ邮箱/163邮箱等）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@qq.com
# SMTP_PASSWORD=your-smtp-authorization-code
# SMTP_FROM_EMAIL=your-email@qq.com

# ------------------------------------------------------------
# 应用地址（生产环境需改为真实域名）
# ------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------
# 支付配置（Stripe）
# PAYMENT_PROVIDER_MODE 可选值：mock（本地测试）| stripe（生产）
# Stripe 控制台：https://dashboard.stripe.com
# ------------------------------------------------------------
PAYMENT_PROVIDER_MODE=mock

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_PRICE_ID=price_your_stripe_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
